<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.hrms.controller.LoginController"
            prefHeight="500.0" prefWidth="700.0"
            styleClass="root">
    
    <center>
        <VBox alignment="CENTER" spacing="20" styleClass="login-container">
            <padding>
                <Insets top="50" right="50" bottom="50" left="50"/>
            </padding>
            
            <!-- Titre -->
            <Label text="HRMS - Système de Gestion RH" styleClass="title">
                <font>
                    <Font name="System Bold" size="24"/>
                </font>
            </Label>
            
            <Label text="Connexion" styleClass="subtitle">
                <font>
                    <Font size="18"/>
                </font>
            </Label>
            
            <!-- Formulaire de connexion -->
            <GridPane hgap="10" vgap="15" alignment="CENTER" maxWidth="400">
                <columnConstraints>
                    <ColumnConstraints minWidth="120" prefWidth="120"/>
                    <ColumnConstraints minWidth="250" prefWidth="250"/>
                </columnConstraints>
                
                <!-- Username -->
                <Label text="Nom d'utilisateur:" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                <TextField fx:id="usernameField" GridPane.columnIndex="1" GridPane.rowIndex="0" 
                          promptText="Entrez votre nom d'utilisateur"/>
                
                <!-- Password -->
                <Label text="Mot de passe:" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                <PasswordField fx:id="passwordField" GridPane.columnIndex="1" GridPane.rowIndex="1"
                              promptText="Entrez votre mot de passe"/>
            </GridPane>
            
            <!-- Message d'erreur -->
            <Label fx:id="errorLabel" textFill="red" visible="false" wrapText="true" maxWidth="400">
                <font>
                    <Font size="12"/>
                </font>
            </Label>
            
            <!-- Bouton de connexion -->
            <Button fx:id="loginButton" text="Se connecter" onAction="#handleLogin" 
                    styleClass="btn-primary" prefWidth="200">
                <font>
                    <Font size="14"/>
                </font>
            </Button>
            
            <!-- Info -->
            <Label text="Utilisateur par défaut: admin / admin" styleClass="info-text">
                <font>
                    <Font size="11"/>
                </font>
            </Label>
            
        </VBox>
    </center>
    
    <bottom>
        <HBox alignment="CENTER" spacing="10" styleClass="footer">
            <padding>
                <Insets top="10" right="10" bottom="10" left="10"/>
            </padding>
            <Label text="© 2026 HRMS - Tous droits réservés">
                <font>
                    <Font size="10"/>
                </font>
            </Label>
        </HBox>
    </bottom>
    
</BorderPane>
